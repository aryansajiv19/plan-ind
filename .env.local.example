# Copy this file to .env.local and fill in from your Supabase project:
#   Project settings → Data API (and API keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Preferred for new Supabase projects. The app still accepts the legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY name during migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public origin used for OAuth/email redirects in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bot protection. Create a Cloudflare Turnstile widget for your production
# hostname. The secret is configured in Supabase Auth; only the site key is
# exposed to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# A high-entropy shared secret used only by server-side quota/audit RPCs.
# Store the same value in public.app_control_secrets as a bcrypt hash.
SECURITY_CONTROL_SECRET=replace-with-at-least-32-random-characters

# Required on production deployments. Legal pages intentionally fail a Vercel
# production build when these are absent rather than publishing fake details.
LEGAL_OPERATOR_NAME=Your legal entity name
LEGAL_CONTACT_EMAIL=privacy@example.com
LEGAL_JURISDICTION=Dubai, United Arab Emirates
