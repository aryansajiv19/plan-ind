{"nodes": [{"id": "auth_setup_supabase_auth_setup", "label": "Supabase Auth Setup Runbook", "file_type": "document", "source_file": "AUTH_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "auth_setup_migration_007_auth", "label": "Migration 007 Auth Binding", "file_type": "concept", "source_file": "AUTH_SETUP.md", "source_location": "lines 5-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Links people.auth_user_id to auth.users.id and owner-scopes profile/friendship/visit/companion mutations while preserving public profile reads and the public shared-plan flow."}, {"id": "auth_setup_no_legacy_identity_claim", "label": "No Legacy Identity Claim", "file_type": "rationale", "source_file": "AUTH_SETUP.md", "source_location": "line 16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A public legacy profile UUID is not proof of ownership, so a new authenticated profile copies only the cached display name/avatar and deliberately does not claim the old public identity or its history."}, {"id": "auth_setup_email_otp", "label": "Email One-Time Code Sign-In", "file_type": "concept", "source_file": "AUTH_SETUP.md", "source_location": "lines 18-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Email templates must render {{ .Token }} so the login UI can accept a six-digit code; a {{ .ConfirmationURL }} template still works through the /auth/callback link flow."}, {"id": "auth_setup_google_oauth", "label": "Google OAuth Provider Config", "file_type": "concept", "source_file": "AUTH_SETUP.md", "source_location": "lines 24-32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google client ID/secret live in Supabase provider settings only; no Google secret belongs in the repository or in a NEXT_PUBLIC_ variable."}, {"id": "auth_se