# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Graphify keeps dated safety backups when rebuilding a curated graph.
/graphify-out/20*/
# Regenerable query cache -- content hashes only, churns every rebuild.
# Was committed 6x with identical content, flagged as false-positive
# "secrets" by a gitleaks scan (2026-09-04) since it's a wall of hex
# strings. Untracked going forward, not purged from history.
/graphify-out/cache/

# scripts/load/mint-voters.mjs writes live-project session tokens here.
/scripts/load/voters.local.json
# scripts/load/mint-local-users.mjs writes local-stack-only session tokens here.
/scripts/load/local-users.local.json

# npx supabase init/start local-dev artifacts (Docker volumes tracked
# separately; these are CLI state/temp files only).
/supabase/.branches/
/supabase/.temp/

# scripts/backfill-spot-coordinates.mjs writes its geocoding results here
# for review -- a one-time local artifact, not committed output. The
# hand-reviewed split (what to apply, what to reject) is derived from it;
# the surviving coordinates live in migration-037, which IS committed.
/scripts/spot-coordinates.local.json
/scripts/spot-coordinates-apply-list.local.json
/scripts/spot-coordinates-rejected.local.json
