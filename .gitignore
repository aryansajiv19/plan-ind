# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local tooling output — never committed
/graphify-out/
/.claude/worktrees/

# scripts/load/mint-voters.mjs writes live-project session tokens here.
/scripts/load/voters.local.json
# scripts/load/mint-local-users.mjs writes local-stack-only session tokens here.
/scripts/load/local-users.local.json

# npx supabase init/start local-dev artifacts (Docker volumes tracked
# separately; these are CLI state/temp files only).
/supabase/.branches/
/supabase/.temp/

# scripts/backfill-spot-coordinates.mjs writes its geocoding results here
# for review -- a one-time local artifact, not committed output. The
# hand-reviewed split (what to apply, what to reject) is derived from it;
# the surviving coordinates live in migration-037, which IS committed.
/scripts/spot-coordinates.local.json
/scripts/spot-coordinates-apply-list.local.json
/scripts/spot-coordinates-rejected.local.json

# scripts/backfill-spot-photos.mjs writes its review output here.
/scripts/spot-photos.local.json

# scripts/places-backfill.ts: the review file holds Google Places content
# (names, ratings, hours) that the Maps terms do not let us keep -- local,
# temporary, delete once the migration is generated. Downloaded venue photos
# wait here for the owner's dashboard upload.
/scripts/places-review.local.json
/scripts/places-photos.local/
# scripts/places-discover.ts: candidate venues, Google content -- review, then delete.
/scripts/places-discovery.local.json
/scripts/places-discovery.local.csv

# Playwright global-setup writes the disposable local plan id here.
/tests/e2e/.fixture.local.json

# Playwright MCP run artifacts (screenshots from verification runs)
.playwright-mcp/

# Installed agent skills (npx skills add). 19MB of third-party trees that are
# not this project's source — restore them with the commands in
# CONTEXT_HYGIENE.md rather than versioning them here. The pattern ignores any
# future install automatically; the ten skills this repo actually owns are
# un-ignored below and stay tracked.
.agents/
skills-lock.json
.claude/skills/*
!.claude/skills/a11y-responsive/
!.claude/skills/code-review/
!.claude/skills/design-standards/
!.claude/skills/house-rules/
!.claude/skills/migrations/
!.claude/skills/openai-responses/
!.claude/skills/rls-policies/
!.claude/skills/secrets-audit/
!.claude/skills/security-review/
!.claude/skills/ui-implementation/

# /brag-slim renders (share the mp4, do not commit it)
/brag-output*/
# scripts/catalogue-osm.ts review outputs (a source per field; skip reasons).
/scripts/catalogue-089.review.local.csv
/scripts/catalogue-089-skipped.local.json
